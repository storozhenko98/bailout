[23.131252, "o", "\r\u001b[2K\r\n  \u001b[1mbash\u001b[0m\r\n  \u001b[1;32m$\u001b[0m set -o pipefail\r\n  \u001b[1;32m$\u001b[0m printf '%s\\n' '--- OS ---'\r\n  \u001b[1;32m$\u001b[0m uname -a\r\n  \u001b[1;32m$\u001b[0m if command -v lsb_release >/dev/null 2>&1; then lsb_release -a; elif [ -f /etc/os-release ]; then cat /etc/os-release; fi\r\n  \u001b[1;32m$\u001b[0m printf '%s\\n' '--- Architecture ---'\r\n  \u001b[1;32m$\u001b[0m uname -m\r\n  \u001b[1;32m$\u001b[0m printf '%s\\n' '--- Existing OpenCode ---'\r\n  \u001b[1;32m$\u001b[0m if command -v opencode >/dev/null 2>&1; then command -v opencode; opencode --version 2>&1 || true; else printf '%s\\n' 'opencode not found in PATH'; fi\r\n  \u001b[1;32m$\u001b[0m printf '%s\\n' '--- Official install instructions ---'\r\n  \u001b[1;32m$\u001b[0m curl -fsSL https://opencode.ai/install | sed -n '1,220p'\r\n"]
