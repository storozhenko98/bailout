[66.154947, "o", "\r\u001b[2K\r\n  \u001b[1mbash\u001b[0m\r\n  \u001b[1;32m$\u001b[0m set -o pipefail\r\n  \u001b[1;32m$\u001b[0m printf '%s\\n' '--- OpenCode executable ---'\r\n  \u001b[1;32m$\u001b[0m stat -c 'path=%n mode=%A size=%s bytes' \"$HOME/.opencode/bin/opencode\"\r\n  \u001b[1;32m$\u001b[0m if command -v readelf >/dev/null 2>&1; then readelf -h \"$HOME/.opencode/bin/opencode\" | sed -n '1,18p'; fi\r\n  \u001b[1;32m$\u001b[0m printf '%s\\n' '--- Version ---'\r\n  \u001b[1;32m$\u001b[0m \"$HOME/.opencode/bin/opencode\" --version\r\n  \u001b[1;32m$\u001b[0m printf '%s\\n' '--- PATH configuration ---'\r\n  \u001b[1;32m$\u001b[0m tail -n 5 \"$HOME/.bashrc\"\r\n"]
