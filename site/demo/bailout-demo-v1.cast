[45.857242, "o", "\r\u001b[2K\r\n  \u001b[1mbash\u001b[0m\r\n  \u001b[1;32m$\u001b[0m set -euo pipefail\r\n  \u001b[1;32m$\u001b[0m backup_dir=\"$HOME/.config/bailout-backups/opencode-install-$(date +%Y%m%d-%H%M%S)\"\r\n  \u001b[1;32m$\u001b[0m mkdir -p \"$backup_dir\"\r\n  \u001b[1;32m$\u001b[0m if [ -f \"$HOME/.bashrc\" ]; then cp -a \"$HOME/.bashrc\" \"$backup_dir/\"; fi\r\n  \u001b[1;32m$\u001b[0m if [ -f \"$HOME/.bash_profile\" ]; then cp -a \"$HOME/.bash_profile\" \"$backup_dir/\"; fi\r\n  \u001b[1;32m$\u001b[0m if [ -f \"$HOME/.profile\" ]; then cp -a \"$HOME/.profile\" \"$backup_dir/\"; fi\r\n  \u001b[1;32m$\u001b[0m printf 'Configuration backup created: %s\\n' \"$backup_dir\"\r\n  \u001b[1;32m$\u001b[0m ls -la \"$backup_dir\"\r\n"]
[45.857945, "o", "\r\u001b[2K  \u001b[1;32m⠋\u001b[0m Running Bash \u001b[90m0s · ctrl-c to stop\u001b[0m"]
