[37.414565, "o", "\r\n  \u001b[1mbash\u001b[0m\r\n  \u001b[1;32m$\u001b[0m set -o pipefail\r\n  \u001b[1;32m$\u001b[0m printf '%s\\n' '--- Current shell environment ---'\r\n  \u001b[1;32m$\u001b[0m printf 'SHELL=%s\\n' \"${SHELL:-<unset>}\"\r\n  \u001b[1;32m$\u001b[0m printf 'HOME=%s\\n' \"$HOME\"\r\n  \u001b[1;32m$\u001b[0m printf 'PATH=%s\\n' \"$PATH\"\r\n  \u001b[1;32m$\u001b[0m printf '%s\\n' '--- Candidate OpenCode config files ---'\r\n  \u001b[1;32m$\u001b[0m for f in \"$HOME/.bashrc\" \"$HOME/.bash_profile\" \"$HOME/.profile\" \"${XDG_CONFIG_HOME:-$HOME/.config}/bash/.bashrc\" \"${XDG_CONFIG_HOME:-$HOME/.config}/bash/.bash_profile\"; do\r\n  \u001b[1;32m$\u001b[0m   if [ -e \"$f\" ]; then\r\n  \u001b[1;32m$\u001b[0m     ls -l \"$f\"\r\n  \u001b[1;32m$\u001b[0m     printf '%s\\n' \"Contents:\"\r\n  \u001b[1;32m$\u001b[0m     sed -n '1,80p' \"$f\"\r\n  \u001b[1;32m$\u001b[0m   else\r\n  \u001b[90m… command continues\u001b[0m\r\n\r\u001b[2K  \u001b[1;32m⠋\u001b[0m Running Bash \u001b[90m0s · ctrl-c to stop\u001b[0m"]
[37.505041, "o", "\r\u001b[2K  \u001b[90m│\u001b[0m --- Current shell environment ---\r\n  \u001b[90m│\u001b[0m SHELL=/bin/bash\r\n  \u001b[90m│\u001b[0m HOME=/root\r\n  \u001b[90m│\u001b[0m PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\r\n  \u001b[90m│\u001b[0m --- Candidate OpenCode config files ---\r\n  \u001b[90m│\u001b[0m -rw-r--r-- 1 root root 3106 Apr 22  2024 /root/.bashrc\r\n  \u001b[90m│\u001b[0m Contents:\r\n  \u001b[90m│\u001b[0m # ~/.bashrc: executed by bash(1) for non-login shells.\r\n  \u001b[90m│\u001b[0m # see /usr/share/doc/bash/examples/startup-files (in the package bash-doc)\r\n  \u001b[90m│\u001b[0m # for examples\r\n  \u001b[90m… 91 more lines · /last to expand\u001b[0m\r\n  \u001b[90mdone · 0.1s\u001b[0m\r\n\r\n"]
