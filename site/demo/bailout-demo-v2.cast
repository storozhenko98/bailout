[108.798181, "o", "\r\n  \u001b[1mbash\u001b[0m\r\n  \u001b[1;32m$\u001b[0m cd /tmp && python3 - <<'EOF' 2>/dev/null || python3.11 - <<'EOF2'\r\n  \u001b[1;32m$\u001b[0m import json\r\n  \u001b[1;32m$\u001b[0m s = json.load(open('opencode-schema.json'))\r\n  \u001b[1;32m$\u001b[0m d = s['$defs']\r\n  \u001b[1;32m$\u001b[0m for k in ['PermissionActionConfig','PermissionRuleConfig']:\r\n  \u001b[1;32m$\u001b[0m     print(f\"=== {k} ===\")\r\n  \u001b[1;32m$\u001b[0m     print(json.dumps(d.get(k), indent=2))\r\n  \u001b[1;32m$\u001b[0m     print()\r\n  \u001b[1;32m$\u001b[0m # find how Config references permission\r\n  \u001b[1;32m$\u001b[0m cfg = d.get('ConfigV2') or d.get('Config')\r\n  \u001b[1;32m$\u001b[0m print(\"=== search Config defs for 'permission' key ===\")\r\n  \u001b[1;32m$\u001b[0m EOF\r\n\r\u001b[2K  \u001b[1;32m⠋\u001b[0m Running Bash \u001b[90m0s · ctrl-c to stop\u001b[0m"]
