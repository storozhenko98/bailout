{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bailout",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "../dist/site",
    "binding": "ASSETS",
    "run_worker_first": [
      "/v1/*",
      "/health",
      "/install.sh"
    ],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "services": [
    {
      "binding": "API",
      "service": "bailout-gateway"
    }
  ],
  "routes": [
    {
      "pattern": "bailout.dev",
      "custom_domain": true
    }
  ],
  "limits": {
    "cpu_ms": 50
  },
  "build": {
    "command": "npm run build:site"
  }
}
